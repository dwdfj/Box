<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.6: 投屏设备选择框。
     结构对齐 dialog_select.xml, 多一条状态行和一颗"重新搜索"。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cast_root"
        android:layout_width="@dimen/vs_520"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="@dimen/vs_50"
        android:background="@drawable/shape_dialog_bg_main"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_30">

        <TextView
            android:id="@+id/cast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/vs_12"
            android:singleLine="true"
            android:text="@string/cast_title"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cast_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingBottom="@dimen/vs_10"
            android:singleLine="true"
            android:text="@string/cast_searching"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cast_title"
            tools:text="正在搜索同一 Wi-Fi 下的电视 / 盒子…" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/cast_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="@dimen/vs_420"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cast_status"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

        <TextView
            android:id="@+id/cast_refresh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_80"
            android:layout_marginTop="@dimen/vs_16"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cast_refresh"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cast_list" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

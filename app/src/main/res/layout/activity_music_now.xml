<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.10: 全屏播放页(喵音乐式) —— 大封面 + 歌名/歌手 + 进度 + 粉紫播放键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_24">

        <TextView
            android:id="@+id/musicNowBack"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_28" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="正在播放"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicNowQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_pill"
            android:paddingLeft="@dimen/vs_20"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_8"
            android:text="flac"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/musicNowCover"
        android:layout_width="@dimen/vs_460"
        android:layout_height="@dimen/vs_460"
        android:layout_marginTop="@dimen/vs_40"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/XjRounded20" />

    <TextView
        android:id="@+id/musicNowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_36"
        android:layout_marginRight="@dimen/vs_60"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_40"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/musicNowSinger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginRight="@dimen/vs_60"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_28" />

    <ProgressBar
        android:id="@+id/musicNowProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_8"
        android:layout_marginLeft="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_36"
        android:layout_marginRight="@dimen/vs_60"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_music_accent_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_60"
        android:paddingRight="@dimen/vs_60">

        <TextView
            android:id="@+id/musicNowPos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/musicNowDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_40"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/musicNowPrev"
            android:layout_width="@dimen/vs_90"
            android:layout_height="@dimen/vs_90"
            android:focusable="true"
            android:gravity="center"
            android:text="⏮"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40" />

        <com.github.tvbox.osc.music.BlobPlayButton
            android:id="@+id/musicBlobPlay"
            android:layout_width="@dimen/vs_160"
            android:layout_height="@dimen/vs_160"
            android:layout_marginLeft="@dimen/vs_40"
            android:layout_marginRight="@dimen/vs_40" />

        <TextView
            android:id="@+id/musicNowNext"
            android:layout_width="@dimen/vs_90"
            android:layout_height="@dimen/vs_90"
            android:focusable="true"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicNowStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_24"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_24" />
</LinearLayout>

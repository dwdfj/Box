<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.16: 全屏播放页 ——
  · 圆形旋转封面, 封面铺满整个圆面(不再只显示中间一小块)
  · 歌词: 卡拉OK扫光 + 发光描边 + 景深 + 呼吸
  · 功能键成一排大圆形按钮(vs_96), 整体上移贴近歌词, 不再散在屏幕底
  · 顶栏"音质"胶囊可点, 点一下切下一档
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicNowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky"
    android:orientation="vertical">

    <!-- 顶栏: 收起 + 线路 / 音质 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_32"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_32">

        <TextView
            android:id="@+id/musicNowBack"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="正在播放"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_34"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicNowLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_pill"
            android:focusable="true"
            android:paddingLeft="@dimen/vs_28"
            android:paddingTop="@dimen/vs_14"
            android:paddingRight="@dimen/vs_28"
            android:paddingBottom="@dimen/vs_14"
            android:text="洛雪"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_28" />

        <TextView
            android:id="@+id/musicNowQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_16"
            android:background="@drawable/bg_music_pill"
            android:focusable="true"
            android:paddingLeft="@dimen/vs_28"
            android:paddingTop="@dimen/vs_14"
            android:paddingRight="@dimen/vs_28"
            android:paddingBottom="@dimen/vs_14"
            android:text="FLAC"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_28" />
    </LinearLayout>

    <!-- 唱片 / 歌词: 点封面切歌词 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/vs_24">

        <LinearLayout
            android:id="@+id/musicDiscArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.github.tvbox.osc.music.RotatingCoverView
                android:id="@+id/musicDiscRing"
                android:layout_width="@dimen/vs_520"
                android:layout_height="@dimen/vs_520" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_28"
                android:text="轻点封面看歌词"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <com.github.tvbox.osc.music.LyricView
            android:id="@+id/musicLyric"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 歌名 / 歌手 -->
    <TextView
        android:id="@+id/musicNowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginRight="@dimen/vs_50"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_44"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/musicNowSinger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_50"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/music_sub"
        android:textSize="@dimen/ts_28" />

    <!-- 进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_24"
        android:layout_marginRight="@dimen/vs_50"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/musicNowPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_26" />

        <SeekBar
            android:id="@+id/musicNowProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_marginRight="@dimen/vs_20"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_music_seek"
            android:thumb="@drawable/bg_music_seek_thumb"
            android:thumbOffset="0dp" />

        <TextView
            android:id="@+id/musicNowDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>

    <!-- 主控制: 上一曲 / Blob / 下一曲 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/musicNowPrev"
            android:layout_width="@dimen/vs_120"
            android:layout_height="@dimen/vs_120"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:text="⏮"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_44" />

        <com.github.tvbox.osc.music.BlobPlayButton
            android:id="@+id/musicBlobPlay"
            android:layout_width="@dimen/vs_220"
            android:layout_height="@dimen/vs_220"
            android:layout_marginLeft="@dimen/vs_40"
            android:layout_marginRight="@dimen/vs_40" />

        <TextView
            android:id="@+id/musicNowNext"
            android:layout_width="@dimen/vs_120"
            android:layout_height="@dimen/vs_120"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_44" />
    </LinearLayout>

    <!-- 功能栏(一排大圆键): 收藏 / 下载 / 音质 / 模式 / 队列 / 线路 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_20">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowFav"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:text="收藏"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowDownload"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="⇩"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:text="下载"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowMode"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <TextView
                android:id="@+id/musicNowModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:text="列表"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowQueue"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:text="队列"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowLineBtn"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="≋"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:text="线路"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/musicNowStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/vs_16"
        android:singleLine="true"
        android:textColor="@color/music_sub"
        android:textSize="@dimen/ts_24" />
</LinearLayout>

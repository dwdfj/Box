<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.4: 快搜页来源条目由「竖排整宽行」改为「横排胶囊」。
     原来 width=match_parent 是为左侧竖排来源列设计的, 竖屏下会占满整行并把结果挤窄。 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvSearchSite"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:background="@drawable/shape_user_search"
    android:ellipsize="end"
    android:focusable="true"
    android:maxWidth="@dimen/vs_300"
    android:paddingLeft="@dimen/vs_16"
    android:paddingRight="@dimen/vs_16"
    android:paddingTop="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_12"
    android:singleLine="true"
    android:textAlignment="center"
    android:textColor="@color/color_FFFFFF"
    android:textSize="@dimen/ts_22" />

<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.22: 影视首页「推荐」页按参考图重做。

  结构(整页在 ScrollView 内一起滚动):
    1. 顶行: 数据源模式胶囊 + 计数(长按胶囊切 豆瓣/站点/历史);
    2. 大图 Banner: 剧照 + 渐变 + 片名 + 评分/年份/类型 + 三行简介 + 圆点指示器,
       每 3.5 秒自动淡入淡出轮播(见 UserFragment.startBannerTicker);
    3. 「正在热映电影」横排(带「更多」→ 切到电影分类);
    4. 「热门电影」横排(带「更多」→ 切到剧集分类);
    5. 3 列海报网格: 只在「播放历史」模式显示(推荐模式下上面两排已经铺满,
       再重复一遍同一批海报就是噪声)。

  保留 id 兼容 Java: tvModeTag/tvHotCount/tvHotHint/tvFeaturedBanner/ivBanner/
  tvBannerTitle/tvBannerMeta/btnBannerCollect/tvHotGrid。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 底部渐变遮罩: 壁纸照常透出, 仅压暗下方信息区保证可读性 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_600"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_home_scrim_bottom"
        android:focusable="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_32"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_32"
            android:paddingBottom="@dimen/vs_340">

            <!-- ① 顶行: 模式胶囊 + 计数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvModeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_focus_tag"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_22"
                    android:paddingRight="@dimen/vs_22"
                    android:paddingTop="@dimen/vs_6"
                    android:paddingBottom="@dimen/vs_6"
                    android:text="@string/hm_focus_enter"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_24" />

                <TextView
                    android:id="@+id/tvHotCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_16"
                    android:layout_marginStart="@dimen/vs_16"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_24" />

                <View
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_1"
                    android:layout_weight="1"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvHotHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:textColor="@color/color_FFFFFF_40"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- ② 大图 Banner -->
            <FrameLayout
                android:id="@+id/tvFeaturedBanner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_520"
                android:layout_marginTop="@dimen/vs_16"
                android:background="@drawable/shape_home_banner"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_2">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_loading_placeholder" />

                <!-- 下三分之一压暗, 保证白色文字可读 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_300"
                    android:layout_gravity="bottom"
                    android:background="@drawable/shape_banner_scrim"
                    android:focusable="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/vs_28"
                    android:paddingRight="@dimen/vs_28"
                    android:paddingBottom="@dimen/vs_44">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_44"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_8"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/color_home_gold"
                        android:textSize="@dimen/ts_26" />

                    <TextView
                        android:id="@+id/tvBannerDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_10"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:lineSpacingExtra="@dimen/vs_6"
                        android:maxLines="3"
                        android:text=""
                        android:textColor="@color/color_FFFFFF_70"
                        android:textSize="@dimen/ts_24" />
                </LinearLayout>

                <!-- 圆点指示器 -->
                <LinearLayout
                    android:id="@+id/bannerDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/vs_16"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- 收藏钮: v27.22 参考图里没有, 保留 id 但常隐(收藏走详情页) -->
                <TextView
                    android:id="@+id/btnBannerCollect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:layout_margin="@dimen/vs_20"
                    android:background="@drawable/btn_focus_detail"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_24"
                    android:paddingRight="@dimen/vs_24"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingBottom="@dimen/vs_10"
                    android:text="@string/hm_btn_collect"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_24"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ③ 正在热映电影 -->
            <LinearLayout
                android:id="@+id/secHotHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_32"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/vs_8"
                    android:layout_height="@dimen/vs_36"
                    android:background="@color/color_aurora_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_16"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:text="热门电影"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_38"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMoreHot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="@dimen/vs_16"
                    android:paddingRight="@dimen/vs_8"
                    android:text="更多"
                    android:textColor="@color/color_aurora_warm"
                    android:textSize="@dimen/ts_28" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rowHot"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_520"
                android:layout_marginTop="@dimen/vs_14"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_selectedItemIsCentered="false" />

            <!-- ④ 热门电影 -->
            <LinearLayout
                android:id="@+id/secHot2Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_28"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/vs_8"
                    android:layout_height="@dimen/vs_36"
                    android:background="@color/color_aurora_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_16"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:text="热门剧集"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_38"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMoreHot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="@dimen/vs_16"
                    android:paddingRight="@dimen/vs_8"
                    android:text="更多"
                    android:textColor="@color/color_aurora_warm"
                    android:textSize="@dimen/ts_28" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rowHot2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_520"
                android:layout_marginTop="@dimen/vs_14"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_selectedItemIsCentered="false" />

            <!-- ⑤ 3 列海报网格: 仅「播放历史」模式可见 -->
            <com.github.tvbox.osc.widget.SafeTvRecyclerView
                android:id="@+id/tvHotGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_24"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone"
                app:tv_selectedItemIsCentered="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

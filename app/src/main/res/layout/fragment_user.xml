<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v15.9: 首页「横屏 · 精选大图 + 网格」(方案B)——
     1. 根布局透明: 透出 BaseActivity 设在 window 上的内置壁纸; 底部叠渐变遮罩保可读性。
     2. 顶行: 数据源模式胶囊(豆瓣热播/站点推荐/播放历史) + 计数 + 操作提示。
     3. 主体(横屏宽屏): 左侧「精选大图 Banner」(剧照 + 标题 + 圆形播放钮 + 收藏钮),
        随右侧网格焦点联动; 右侧「多列海报网格」(4 列)铺开, 信息密度高、无大空白。
     4. 底部入口收成 1 个「更多」按钮, 点击展开 5 项面板(历史/直播/收藏/推送/网盘)。
     保留旧 id 兼容 Java: tvModeTag/tvHotCount/tvHotHint/tvHotListForGrid(本版指右侧网格)/tvUserHome
     /tvHistory/tvLive/tvFavorite/tvPush/tvDrive -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 底部渐变遮罩: 壁纸照常透出, 仅压暗下方信息区保证可读性 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_250"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_home_scrim_bottom"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_50"
        android:paddingRight="@dimen/vs_50">

        <!-- ① 顶行: 数据源模式胶囊 + 计数 + 操作提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModeTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_focus_tag"
                android:focusable="false"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_14"
                android:paddingRight="@dimen/vs_14"
                android:paddingTop="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_2"
                android:text="@string/hm_focus_enter"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_18" />

            <TextView
                android:id="@+id/tvHotCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:layout_marginStart="@dimen/vs_12"
                android:focusable="false"
                android:gravity="center_vertical"
                android:textColor="@color/color_FFFFFF_70"
                android:textSize="@dimen/ts_18" />

            <View
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_1"
                android:layout_weight="1"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvHotHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/hm_home_hint"
                android:textColor="@color/color_FFFFFF_40"
                android:textSize="@dimen/ts_15" />
        </LinearLayout>

        <!-- ② 主体: 左侧精选 Banner + 右侧多列网格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_12"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:orientation="horizontal">

            <!-- 左侧: 精选大图 Banner(随网格焦点联动) -->
            <FrameLayout
                android:id="@+id/tvFeaturedBanner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/vs_16"
                android:layout_weight="0.42"
                android:background="@drawable/shape_dock_btn"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/tvDockBtn"
                android:nextFocusRight="@id/tvHotGrid"
                android:padding="@dimen/vs_1">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_loading_placeholder" />

                <!-- 底部渐变遮罩, 保证标题/按钮可读 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_200"
                    android:layout_gravity="bottom"
                    android:background="@drawable/shape_banner_scrim"
                    android:focusable="false" />

                <!-- 底部信息区: 标题 + 元信息 + 操作钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:padding="@dimen/vs_18">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_36"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/color_FFFFFF_70"
                        android:textSize="@dimen/ts_18"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_14"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 圆形播放钮(视觉, 整体 Banner 可点即播) -->
                        <FrameLayout
                            android:layout_width="@dimen/vs_56"
                            android:layout_height="@dimen/vs_56"
                            android:background="@drawable/shape_play_circle"
                            android:focusable="false"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:text="▶"
                                android:textColor="#FF000000"
                                android:textSize="@dimen/ts_26" />
                        </FrameLayout>

                        <!-- 收藏钮(可聚焦) -->
                        <TextView
                            android:id="@+id/btnBannerCollect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/vs_16"
                            android:layout_marginStart="@dimen/vs_16"
                            android:background="@drawable/btn_focus_detail"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:nextFocusDown="@id/tvDockBtn"
                            android:nextFocusLeft="@id/tvFeaturedBanner"
                            android:paddingLeft="@dimen/vs_26"
                            android:paddingRight="@dimen/vs_26"
                            android:paddingTop="@dimen/vs_8"
                            android:paddingBottom="@dimen/vs_8"
                            android:text="@string/hm_btn_collect"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/ts_20" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- 右侧: 多列海报网格(默认 4 列, 横屏铺满) -->
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/tvHotGrid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.58"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusLeft="@id/tvFeaturedBanner"
                android:nextFocusUp="@id/mGridViewCategory"
                app:tv_selectedItemIsCentered="false" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_4"
            android:focusable="false" />

        <!-- ④ 底部入口: 单按钮 + 点击展开的 5 项面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:gravity="right|center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/vs_6">

            <!-- 展开后的入口面板(默认 GONE, 点击右侧按钮才出现) -->
            <LinearLayout
                android:id="@+id/tvUserHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_dock_panel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/vs_4"
                android:visibility="gone">

                <!-- v15.12: Dock 首位加「搜索」入口(放大镜), 让用户收起/展开即有明确的搜索按钮 -->
                <LinearLayout
                    android:id="@+id/tvSearch"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_search"
                        app:srcCompat="@drawable/hm_search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_search"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvHistory"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_hist"
                        app:srcCompat="@drawable/hm_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_hist"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvLive"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_live"
                        app:srcCompat="@drawable/hm_live" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_live"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvFavorite"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_fav"
                        app:srcCompat="@drawable/hm_fav" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_fav"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvPush"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_push"
                        app:srcCompat="@drawable/hm_push" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_push"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvDrive"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_56"
                    android:layout_margin="@dimen/vs_3"
                    android:background="@drawable/shape_user_home_mini"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvHotGrid"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/vs_22"
                        android:layout_height="@dimen/vs_22"
                        android:alpha="0.9"
                        android:contentDescription="@string/hm_file"
                        app:srcCompat="@drawable/hm_folder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/hm_file"
                        android:textColor="@color/color_FFFFFF_90"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>
            </LinearLayout>

            <!-- 「更多」按钮: 点击展开/收起上面的入口面板 -->
            <LinearLayout
                android:id="@+id/tvDockBtn"
                android:layout_width="@dimen/vs_60"
                android:layout_height="@dimen/vs_56"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/shape_dock_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@id/btnBannerCollect"
                android:nextFocusUp="@id/tvHotGrid"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/vs_26"
                    android:layout_height="@dimen/vs_26"
                    android:alpha="0.95"
                    android:contentDescription="@string/hm_dock_more"
                    app:srcCompat="@drawable/hm_drawer" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

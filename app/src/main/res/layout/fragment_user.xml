<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.x 竖屏首页「沉浸海报流」(方案A)。
     结构(自上而下, 整页在 ScrollView 内一起滚动):
       1. 根 FrameLayout 透明: 透出 BaseActivity 设在 window 上的内置壁纸; 底部叠渐变遮罩保可读。
       2. 顶行: 数据源模式胶囊(豆瓣热播/站点推荐/播放历史) + 计数 + 操作提示。
       3. 精选大图 Banner: 随页面上滑一起滚走(不再吸顶固定 —— v23.x 按用户反馈改为随列表滚走)。
       4. 3 列海报网格: 整页滚动, 网格自身不独立滚动(见 UserFragment setNestedScrollingEnabled(false))。
     底部「更多」dock 已移除(用户要求): 历史/收藏/推送/网盘走设置页与搜索页;
     直播入口已上移至顶栏(设置按钮旁)。
     保留 id 兼容 Java: tvModeTag/tvHotCount/tvHotHint/tvFeaturedBanner/ivBanner/
     tvBannerTitle/tvBannerMeta/btnBannerCollect/tvHotGrid。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 底部渐变遮罩: 壁纸照常透出, 仅压暗下方信息区保证可读性 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_600"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_home_scrim_bottom"
        android:focusable="false" />

    <!-- 整页滚动容器: Banner 与网格一起滚, 上滑时大图自然滚出屏幕 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40"
            android:paddingBottom="@dimen/vs_30">

            <!-- ① 顶行: 数据源模式胶囊 + 计数 + 操作提示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvModeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_focus_tag"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_22"
                    android:paddingRight="@dimen/vs_22"
                    android:paddingTop="@dimen/vs_6"
                    android:paddingBottom="@dimen/vs_6"
                    android:text="@string/hm_focus_enter"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_24" />

                <TextView
                    android:id="@+id/tvHotCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_16"
                    android:layout_marginStart="@dimen/vs_16"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_24" />

                <View
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_1"
                    android:layout_weight="1"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvHotHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:textColor="@color/color_FFFFFF_40"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- ② 精选大图 Banner(竖屏: 独占一行, 随下方网格焦点联动; 整页滚动时一起上滑滚走) -->
            <FrameLayout
                android:id="@+id/tvFeaturedBanner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_760"
                android:layout_marginTop="@dimen/vs_14"
                android:background="@drawable/shape_home_banner"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/tvHotGrid"
                android:padding="@dimen/vs_2">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_loading_placeholder" />

                <!-- 底部渐变遮罩, 保证标题/按钮可读 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_460"
                    android:layout_gravity="bottom"
                    android:background="@drawable/shape_banner_scrim"
                    android:focusable="false" />

                <!-- 底部信息区: 标题 + 元信息 + 操作钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:padding="@dimen/vs_40">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_50"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_8"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/color_FFFFFF_70"
                        android:textSize="@dimen/ts_26"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_24"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 圆形播放钮(视觉, 整体 Banner 可点即播) -->
                        <FrameLayout
                            android:layout_width="@dimen/vs_100"
                            android:layout_height="@dimen/vs_100"
                            android:background="@drawable/shape_play_circle"
                            android:focusable="false"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:text="▶"
                                android:textColor="#FF000000"
                                android:textSize="@dimen/ts_40" />
                        </FrameLayout>

                        <!-- 收藏钮(可聚焦) -->
                        <TextView
                            android:id="@+id/btnBannerCollect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/vs_26"
                            android:layout_marginStart="@dimen/vs_26"
                            android:background="@drawable/btn_focus_detail"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:nextFocusDown="@id/tvHotGrid"
                            android:nextFocusUp="@id/tvFeaturedBanner"
                            android:paddingLeft="@dimen/vs_40"
                            android:paddingRight="@dimen/vs_40"
                            android:paddingTop="@dimen/vs_14"
                            android:paddingBottom="@dimen/vs_14"
                            android:text="@string/hm_btn_collect"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/ts_30" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ③ 3 列海报网格(竖屏铺满, 整页滚动, 自身不独立滚动) -->
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/tvHotGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/tvFeaturedBanner"
                app:tv_selectedItemIsCentered="false" />

            <View
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_20"
                android:focusable="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

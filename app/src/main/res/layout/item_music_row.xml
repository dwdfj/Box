<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.5: 音乐厅分区行(标题 + 横向封面墙, 上下键跨行 / 左右键行内走) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_14"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_34"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_16"
        android:paddingRight="@dimen/vs_16" />
</LinearLayout>

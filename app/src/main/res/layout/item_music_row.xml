<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.5: 音乐厅分区行(强调色小条 + 标题 + 横向封面墙) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_26"
        android:paddingBottom="@dimen/vs_14">

        <View
            android:layout_width="@dimen/vs_8"
            android:layout_height="@dimen/vs_36"
            android:background="@drawable/bg_music_accent_bar" />

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_14"
            android:focusable="false"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_34"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_22"
        android:paddingRight="@dimen/vs_22" />
</LinearLayout>

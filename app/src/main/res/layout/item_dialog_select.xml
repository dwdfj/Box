<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.3: 信号源面板/通用选择框的列表项。
     v27.18: 选中态改为「主题紫实底 + 白描边」的选择框(shape_chip_select), 不再靠 "√ " 前缀 ——
     前缀会让文字左右跳动, 而且一眼看不出哪一行是当前项。字号 ts_22 -> ts_26, 内边距同步放大。 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvName"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_chip_select"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center_vertical"
    android:maxLines="2"
    android:paddingLeft="@dimen/vs_20"
    android:paddingTop="@dimen/vs_14"
    android:paddingRight="@dimen/vs_20"
    android:paddingBottom="@dimen/vs_14"
    android:text="@{name}"
    android:textColor="@color/color_FFFFFF"
    android:textSize="@dimen/ts_26"
    tools:text="Source Name" />
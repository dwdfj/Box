<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.15: 榜单/歌单封面卡放大(320 方形), 文字加大 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/vs_320"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/vs_24"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/itemSheetCover"
        android:layout_width="@dimen/vs_320"
        android:layout_height="@dimen/vs_320"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/XjRounded20" />

    <TextView
        android:id="@+id/itemSheetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_6"
        android:layout_marginTop="@dimen/vs_12"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_30" />

    <TextView
        android:id="@+id/itemSheetSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_6"
        android:layout_marginTop="@dimen/vs_4"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_24" />
</LinearLayout>

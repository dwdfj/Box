<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.5: 音乐厅封面卡片(横行内固定宽 240 方形圆角封面, TV 焦点缩放由代码挂) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/vs_280"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemSheetCover"
            android:layout_width="@dimen/vs_280"
            android:layout_height="@dimen/vs_280"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/XjRounded20" />

    <TextView
        android:id="@+id/itemSheetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_6"
        android:layout_marginTop="@dimen/vs_10"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_26" />

    <TextView
        android:id="@+id/itemSheetSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_6"
        android:layout_marginTop="@dimen/vs_2"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />
</LinearLayout>

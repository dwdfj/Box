<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_52"
    android:background="@drawable/button_home_sort_focus"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_16"
    android:paddingRight="@dimen/vs_10">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:focusable="false"
        android:gravity="left|center_vertical"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_26" />

    <ImageView
        android:id="@+id/tvFilter"
        android:layout_width="@dimen/vs_26"
        android:layout_height="@dimen/vs_26"
        android:layout_marginStart="@dimen/vs_3"
        android:layout_marginLeft="@dimen/vs_3"
        android:src="@drawable/icon_filter"
        android:visibility="gone" />
</LinearLayout>

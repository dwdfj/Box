<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23 竖屏: 分类胶囊 —— 行高 vs_45 → vs_90(≈手机 34dp chip 标准), 文字 ts_30 → ts_34,
     左右内边距 vs_20 → vs_30, 筛选图标 vs_26 → vs_34。
     背景仍是 button_home_sort_focus(聚焦白描边 + 主题色底), 文字色 color_home_sort_title(聚焦纯白)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/vs_90"
    android:background="@drawable/button_home_sort_focus"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_30"
    android:paddingRight="@dimen/vs_30">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:ellipsize="end"
        android:focusable="false"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/color_home_sort_title"
        android:textSize="@dimen/ts_34" />

    <ImageView
        android:id="@+id/tvFilter"
        android:layout_width="@dimen/vs_34"
        android:layout_height="@dimen/vs_34"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/vs_5"
        android:layout_marginLeft="@dimen/vs_5"
        android:src="@drawable/icon_filter"
        android:visibility="gone" />
</LinearLayout>

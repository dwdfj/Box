<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.5 搜索结果卡片: 严格 3:4 竖版海报 + 标题在下(与首页 item_user_home_grid 同比例)。
     为什么必须改: <=v23.4 的写法是 海报容器 layout_height="0dp" + layout_weight="1",
     却挂在 layout_height="wrap_content" 的卡片根上 —— 这是无效的高度写法。
     LinearLayout 只在父容器高度是"确定值"(MeasureSpec.EXACTLY)时, 才会把剩余空间按权重
     分给 0dp 子项; wrap_content 的卡片先按内容算出高度, 剩余空间算出来是 0, 整段权重分配
     直接被跳过(源码里 skippedMeasure=false 且 remainingExcess=0), 于是海报保持首次测量的
     0 高 —— 封面撑不起来, 卡片只剩一行标题, 看起来就是"细长条"。
     改为 ConstraintLayout 的 layout_constraintDimensionRatio="3:4": 高度由宽度按 3:4 算,
     与首页 3 列竖版海报完全一致, 不再依赖任何权重/父高度。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_thumb_radius"
    android:focusable="true"
    android:padding="@dimen/vs_6">

    <!-- 海报: 宽度铺满卡片, 高度 = 宽度 × 4/3 (3:4) -->
    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_loading_placeholder"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 左上角: 来源名(竖排来源列取消后, 来源信息移到卡片角标)
         小贾影视仓 v23.8: 字号由 ts_22(36mm) 放大到 ts_28(46mm), 内边距同步加大
         —— 用户反馈"搜索界面播放源文字太小了"。 -->
    <TextView
        android:id="@+id/tvSite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vs_8"
        android:background="@drawable/shape_thumb_year"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="@dimen/vs_225"
        android:paddingLeft="@dimen/vs_14"
        android:paddingRight="@dimen/vs_14"
        android:paddingTop="@dimen/vs_6"
        android:paddingBottom="@dimen/vs_6"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_28"
        app:layout_constraintStart_toStartOf="@id/ivThumb"
        app:layout_constraintTop_toTopOf="@id/ivThumb" />

    <!-- 右下角: 备注(更新至第X集 / 4K / HD) -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vs_8"
        android:background="@drawable/shape_thumb_note"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="@dimen/vs_210"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingTop="@dimen/vs_4"
        android:paddingBottom="@dimen/vs_4"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22"
        app:layout_constraintBottom_toBottomOf="@id/ivThumb"
        app:layout_constraintEnd_toEndOf="@id/ivThumb" />

    <!-- 标题: 海报下方独立一行, 最多两行 -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/vs_2"
        android:maxLines="2"
        android:text="Title"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivThumb" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v24.7 搜索结果卡片: 标题在上、海报在下 —— 用户反馈"右侧影视名字显示不全，
     整体文字变大，影视封面位置下移不就解决了吗"。
     为什么这样改: 旧结构海报在上(占满 3:4)、标题在下且 maxLines=3 + ellipsize=end,
     长标题会被省略号截断; 且海报先占掉大块高度, 标题空间天然不足。
     新结构: 标题放卡片顶部、不限制行数(不省略), 海报约束到标题下方 ——
     标题多长都能完整显示, 海报位置自然下移让位, 两者互不挤压。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_thumb_radius"
    android:focusable="true"
    android:padding="@dimen/vs_6">

    <!-- 标题: 卡片顶部通栏, 字号加大(ts_30), 不限行数不省略 —— 完整显示影视名 -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/vs_2"
        android:paddingBottom="@dimen/vs_10"
        android:text="Title"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 海报: 宽度铺满卡片, 高度 = 宽度 × 4/3 (3:4), 位置在标题下方(标题越长海报越往下) -->
    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_loading_placeholder"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <!-- 左上角: 来源名(竖排来源列取消后, 来源信息移到卡片角标)
         小贾影视仓 v23.8: 字号由 ts_22(36mm) 放大到 ts_28(46mm)。 -->
    <TextView
        android:id="@+id/tvSite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vs_8"
        android:background="@drawable/shape_thumb_year"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="@dimen/vs_225"
        android:paddingLeft="@dimen/vs_14"
        android:paddingRight="@dimen/vs_14"
        android:paddingTop="@dimen/vs_6"
        android:paddingBottom="@dimen/vs_6"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_28"
        app:layout_constraintStart_toStartOf="@id/ivThumb"
        app:layout_constraintTop_toTopOf="@id/ivThumb" />

    <!-- 右下角: 备注(更新至第X集 / 4K / HD)
         小贾影视仓 v24.5: 字号 ts_22 → ts_26、限宽 vs_210 → vs_240。 -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vs_8"
        android:background="@drawable/shape_thumb_note"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="@dimen/vs_240"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingTop="@dimen/vs_4"
        android:paddingBottom="@dimen/vs_4"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_26"
        app:layout_constraintBottom_toBottomOf="@id/ivThumb"
        app:layout_constraintEnd_toEndOf="@id/ivThumb" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.5: 内置音乐厅(Voyage 式) —— 顶部横滑推荐大图 + 分区横向封面墙 + 底部播放条(封面旋转+进度) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_aurora_bg"
    android:orientation="vertical">

    <!-- 顶栏: 返回 + 标题 + 音源切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_20">

        <TextView
            android:id="@+id/musicBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_top_icon_btn"
            android:focusable="true"
            android:nextFocusRight="@+id/musicSourceBtn"
            android:padding="@dimen/vs_16"
            android:text="←"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:text="音乐厅"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicSourceBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_top_icon_btn"
            android:focusable="true"
            android:nextFocusLeft="@+id/musicBack"
            android:nextFocusDown="@+id/musicSearchInput"
            android:paddingLeft="@dimen/vs_24"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_24"
            android:paddingBottom="@dimen/vs_16"
            android:text="音源"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30" />
    </LinearLayout>

    <!-- 搜索行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20">

        <EditText
            android:id="@+id/musicSearchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape_home_search_box"
            android:hint="搜索歌曲 / 歌手"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@+id/musicSearchBtn"
            android:padding="@dimen/vs_20"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textColorHint="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_30" />

        <TextView
            android:id="@+id/musicSearchBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_top_icon_btn"
            android:focusable="true"
            android:nextFocusDown="@+id/musicRows"
            android:nextFocusLeft="@+id/musicSourceBtn"
            android:padding="@dimen/vs_20"
            android:text="搜索"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_24"
        android:singleLine="true"
        android:text="正在加载音乐厅…"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_24" />

    <!-- 分区行列表(Banner 行 + 分区封面墙行) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/musicRows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_music_enter"
        android:paddingBottom="@dimen/vs_20" />

    <!-- 播放进度细条 -->
    <ProgressBar
        android:id="@+id/musicProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_3"
        android:layout_marginLeft="@dimen/vs_24"
        android:layout_marginRight="@dimen/vs_24"
        android:layout_marginBottom="@dimen/vs_10"
        android:max="1000"
        android:progress="0"
        android:progressTint="#B3FFFFFF"
        android:visibility="gone" />

    <!-- 底部播放条 -->
    <LinearLayout
        android:id="@+id/musicPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_16"
        android:layout_marginTop="0dp"
        android:layout_marginRight="@dimen/vs_16"
        android:layout_marginBottom="@dimen/vs_16"
        android:background="@drawable/shape_music_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_20"
        android:visibility="gone">

        <ImageView
            android:id="@+id/musicNowCover"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28" />

            <TextView
                android:id="@+id/musicNowInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_top_icon_btn"
            android:focusable="true"
            android:padding="@dimen/vs_20"
            android:text="⏸"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36" />
    </LinearLayout>
</LinearLayout>

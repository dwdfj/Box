<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.20: 顶部再下降、搜索框再宽、dock 通栏 ——
  1) 内容顶部呼吸区 vs_104 → vs_160(叠加状态栏高度), 顶栏整体下移;
  2) 内容左右 vs_22 → vs_14, 搜索框高度 vs_168 → vs_184, 右侧圆键 vs_132;
  3) dock 外层左右 vs_10 → vs_4(基本贴边), 高度 vs_128 → vs_144, 字号 ts_40;
  4) 灵动条跟着底栏一起通栏, 封面圈/播放键 vs_170, 下一曲 vs_120;
  5) 返回键 = 玻璃圆角方块 + 矢量 chevron(vs_104);
  6) 大标题是每天一换的 3 字短句(见 MusicActivity.dailyGreet)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky">

    <LinearLayout
        android:id="@+id/musicContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_14"
        android:paddingTop="@dimen/vs_160"
        android:paddingRight="@dimen/vs_14"
        android:paddingBottom="@dimen/vs_280">

        <!-- 顶栏: 返回 + 问候 + 线路胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- v27.19: 返回键重新设计 —— 从「圆形底 + 细字符 ‹」换成
                 玻璃感圆角方块 + 矢量 chevron 图标, 更大更清楚 -->
            <ImageView
                android:id="@+id/musicBack"
                android:layout_width="@dimen/vs_104"
                android:layout_height="@dimen/vs_104"
                android:background="@drawable/bg_music_back"
                android:contentDescription="返回"
                android:focusable="true"
                android:nextFocusRight="@+id/musicSearchInput"
                android:padding="@dimen/vs_28"
                android:scaleType="centerInside"
                android:src="@drawable/ic_music_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicGreetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_28" />

                <TextView
                    android:id="@+id/musicPaneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:singleLine="true"
                    android:text="晚上好"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_56"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 线路胶囊(可切换音源) -->
            <TextView
                android:id="@+id/musicSourceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_32"
                android:paddingTop="@dimen/vs_20"
                android:paddingRight="@dimen/vs_32"
                android:paddingBottom="@dimen/vs_20"
                android:text="洛雪"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28" />
        </LinearLayout>

        <!-- 搜索: 加宽 + 加高 + 右侧内嵌圆形键 (v27.19 再放大一档) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_184"
            android:layout_marginTop="@dimen/vs_28"
            android:background="@drawable/bg_music_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_44"
            android:paddingRight="@dimen/vs_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_50" />

            <EditText
                android:id="@+id/musicSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_18"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="搜索歌曲 / 歌手 / 歌单"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:nextFocusDown="@+id/musicRows"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/music_sub"
                android:textSize="@dimen/ts_36" />

            <TextView
                android:id="@+id/musicSearchBtn"
                android:layout_width="@dimen/vs_132"
                android:layout_height="@dimen/vs_132"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/musicRows"
                android:text="⌕"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_50"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/vs_12"
            android:singleLine="true"
            android:text="正在加载…"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_24" />

        <!-- 内容区: 吃满剩余高度 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musicRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_music_enter"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_20" />
    </LinearLayout>

    <!-- 底部悬浮区: dock(首页/我的) + 灵动条 -->
    <LinearLayout
        android:id="@+id/musicBottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_4"
        android:paddingRight="@dimen/vs_4"
        android:paddingBottom="@dimen/vs_20">

        <!-- 悬浮 dock: v27.20 继续通栏(左右只留 vs_4) + 高度再加到 vs_144 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_20"
            android:background="@drawable/bg_music_pill"
            android:orientation="horizontal"
            android:padding="@dimen/vs_12">

            <TextView
                android:id="@+id/musicTabHome"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_144"
                android:layout_weight="1"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:gravity="center"
                android:text="⌂ 首页"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicTabMine"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_144"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:focusable="true"
                android:gravity="center"
                android:text="♫ 我的"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_40" />
        </LinearLayout>

        <!-- 灵动条(Mini Player) -->
        <LinearLayout
            android:id="@+id/musicPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_player_bar"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_28"
            android:paddingTop="@dimen/vs_24"
            android:paddingRight="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_24"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/vs_170"
                android:layout_height="@dimen/vs_170">

                <com.github.tvbox.osc.music.CoverRingView
                    android:id="@+id/musicNowRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/musicNowCover"
                    android:layout_width="@dimen/vs_126"
                    android:layout_height="@dimen/vs_126"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_circle"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_26"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicNowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_40"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_8"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_32" />
            </LinearLayout>

            <com.github.tvbox.osc.music.BlobPlayButton
                android:id="@+id/musicBlobPlay"
                android:layout_width="@dimen/vs_170"
                android:layout_height="@dimen/vs_170" />

            <!-- v27.16: 下一曲换成独立圆形按钮(原来是一个裸 ⏭ 字符, 太单薄) -->
            <TextView
                android:id="@+id/musicNextBtn"
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_120"
                android:layout_marginLeft="@dimen/vs_14"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_44" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

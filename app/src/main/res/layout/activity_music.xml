<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.22: 底栏结构重排 ——
  1) 灵动条(播放条)移到 dock 上方(原来是 dock 在上面), 视觉顺序 = 内容 → 灵动条 → dock;
  2) dock 彻底通栏(左右 0 留白) + 更高(vs_184) + 小圆角(bg_music_dock), 不再是"小胶囊";
  3) dock 距屏幕底部留白 vs_32(再叠加导航栏高度, 见 MusicActivity.applySysBarPadding);
  4) 灵动条整体放大: 封面圈/播放键 vs_190, 下一曲 vs_132, 歌名 ts_44, 副信息 ts_34;
  5) 内容底部留白 vs_480, 保证最后一行不被弹层盖住。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky">

    <LinearLayout
        android:id="@+id/musicContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_14"
        android:paddingTop="@dimen/vs_160"
        android:paddingRight="@dimen/vs_14"
        android:paddingBottom="@dimen/vs_480">

        <!-- 顶栏: 返回 + 问候 + 线路胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- v27.19: 返回键重新设计 —— 从「圆形底 + 细字符 ‹」换成
                 玻璃感圆角方块 + 矢量 chevron 图标, 更大更清楚 -->
            <ImageView
                android:id="@+id/musicBack"
                android:layout_width="@dimen/vs_104"
                android:layout_height="@dimen/vs_104"
                android:background="@drawable/bg_music_back"
                android:contentDescription="返回"
                android:focusable="true"
                android:nextFocusRight="@+id/musicSearchInput"
                android:padding="@dimen/vs_28"
                android:scaleType="centerInside"
                android:src="@drawable/ic_music_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicGreetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_28" />

                <TextView
                    android:id="@+id/musicPaneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:singleLine="true"
                    android:text="晚上好"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_56"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 线路胶囊(可切换音源) -->
            <TextView
                android:id="@+id/musicSourceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_32"
                android:paddingTop="@dimen/vs_20"
                android:paddingRight="@dimen/vs_32"
                android:paddingBottom="@dimen/vs_20"
                android:text="洛雪"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28" />
        </LinearLayout>

        <!-- 搜索: v27.24 再收窄一档(左右各留 vs_28), 不再顶到内容区两边 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_184"
            android:layout_marginLeft="@dimen/vs_28"
            android:layout_marginTop="@dimen/vs_28"
            android:layout_marginRight="@dimen/vs_28"
            android:background="@drawable/bg_music_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_44"
            android:paddingRight="@dimen/vs_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_50" />

            <EditText
                android:id="@+id/musicSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_18"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="搜索歌曲 / 歌手 / 歌单"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:nextFocusDown="@+id/musicRows"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/music_sub"
                android:textSize="@dimen/ts_36" />

            <TextView
                android:id="@+id/musicSearchBtn"
                android:layout_width="@dimen/vs_132"
                android:layout_height="@dimen/vs_132"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/musicRows"
                android:text="⌕"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_50"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/vs_12"
            android:singleLine="true"
            android:text="正在加载…"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_24" />

        <!-- 内容区: 吃满剩余高度 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musicRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_music_enter"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_20" />
    </LinearLayout>

    <!-- 底部悬浮区: v27.22 顺序对调 —— 灵动条在上, dock 在下; dock 距底部留 vs_32 -->
    <LinearLayout
        android:id="@+id/musicBottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_0"
        android:paddingRight="@dimen/vs_0"
        android:paddingBottom="@dimen/vs_120">

        <!-- 灵动条(Mini Player): v27.23 长度收短 —— 左右各留 vs_24, 不再通栏 -->
        <LinearLayout
            android:id="@+id/musicPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_56"
            android:layout_marginRight="@dimen/vs_56"
            android:layout_marginBottom="@dimen/vs_40"
            android:background="@drawable/bg_music_player_bar"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_32"
            android:paddingTop="@dimen/vs_26"
            android:paddingRight="@dimen/vs_18"
            android:paddingBottom="@dimen/vs_26"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/vs_190"
                android:layout_height="@dimen/vs_190">

                <com.github.tvbox.osc.music.CoverRingView
                    android:id="@+id/musicNowRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/musicNowCover"
                    android:layout_width="@dimen/vs_142"
                    android:layout_height="@dimen/vs_142"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_circle"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_28"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicNowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_44"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_8"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_34" />
            </LinearLayout>

            <!-- v27.24: 音质胶囊 —— 播放中直接显示当前档位, 点开可选档 -->
            <TextView
                android:id="@+id/musicPlayerQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_22"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_22"
                android:paddingBottom="@dimen/vs_10"
                android:text="FLAC"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26" />

            <com.github.tvbox.osc.music.BlobPlayButton
                android:id="@+id/musicBlobPlay"
                android:layout_width="@dimen/vs_190"
                android:layout_height="@dimen/vs_190" />

            <!-- v27.16: 下一曲换成独立圆形按钮(原来是一个裸 ⏭ 字符, 太单薄) -->
            <TextView
                android:id="@+id/musicNextBtn"
                android:layout_width="@dimen/vs_132"
                android:layout_height="@dimen/vs_132"
                android:layout_marginLeft="@dimen/vs_14"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_44" />
        </LinearLayout>

        <!-- 悬浮 dock: v27.24 再收短(左右 vs_96), 与灵动条之间靠 marginBottom 留出间隙 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_96"
            android:layout_marginRight="@dimen/vs_96"
            android:background="@drawable/bg_music_dock"
            android:orientation="horizontal"
            android:padding="@dimen/vs_8">

            <TextView
                android:id="@+id/musicTabHome"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:gravity="center"
                android:text="⌂ 首页"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_44"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicTabMine"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_weight="1"
                android:focusable="true"
                android:gravity="center"
                android:text="♫ 我的"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_44" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

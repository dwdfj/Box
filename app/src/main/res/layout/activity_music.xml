<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.9: 音乐厅改上下布局 —— 顶栏 → 横向标签页(音乐馆/排行榜/精品歌单) → 状态行 → 内容区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky"
    android:orientation="vertical">

    <!-- 顶栏: 返回 + 标题 + 搜索 + 音源 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_30">

        <TextView
            android:id="@+id/musicBack"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@+id/musicSearchBtn"
            android:text="‹"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36" />

        <TextView
            android:id="@+id/musicPaneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="音乐馆"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/musicSearchInput"
            android:layout_width="@dimen/vs_530"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_pill"
            android:hint="搜索歌曲 / 歌手"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@+id/musicSearchBtn"
            android:padding="@dimen/vs_16"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textColorHint="@color/music_sub"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/musicSearchBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_12"
            android:background="@drawable/bg_music_accent_btn"
            android:focusable="true"
            android:nextFocusDown="@+id/musicNav"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_16"
            android:text="搜索"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicSourceBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_12"
            android:background="@drawable/bg_music_pill"
            android:focusable="true"
            android:nextFocusLeft="@+id/musicBack"
            android:nextFocusDown="@+id/musicNav"
            android:paddingLeft="@dimen/vs_24"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_24"
            android:paddingBottom="@dimen/vs_16"
            android:text="flac"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_30"
        android:singleLine="true"
        android:text="正在加载音乐馆…"
        android:textColor="@color/music_sub"
        android:textSize="@dimen/ts_22" />

    <!-- 内容区(Banner 行 + 分区封面墙行) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/musicRows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutAnimation="@anim/layout_music_enter"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_20" />

    <!-- 播放进度细条(粉紫渐变) -->
    <ProgressBar
        android:id="@+id/musicProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_5"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_marginRight="@dimen/vs_30"
        android:layout_marginBottom="@dimen/vs_10"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_music_accent_bar"
        android:visibility="gone" />

    <!-- 底部播放条(浮岛玻璃) -->
    <LinearLayout
        android:id="@+id/musicPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_24"
        android:layout_marginRight="@dimen/vs_24"
        android:layout_marginBottom="@dimen/vs_20"
        android:background="@drawable/bg_music_player_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_16"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_16"
        android:visibility="gone">

        <ImageView
            android:id="@+id/musicNowCover"
            android:layout_width="@dimen/vs_90"
            android:layout_height="@dimen/vs_90"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicNowInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:singleLine="true"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_accent_btn"
            android:focusable="true"
            android:padding="@dimen/vs_24"
            android:text="⏸"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.16: 音乐首页按设计图重做 ——
  1) 顶部留呼吸区(paddingTop vs_40), 返回键 vs_80, 不再被系统栏顶边压着;
  2) 搜索框加宽加高: 左右留 vs_40, 高度 vs_120, 右侧内嵌圆形搜索键;
  3) 删掉「上下键选行…」提示行(v27.16 按老大要求去掉 —- TV 操作提示不该占首页);
  4) 删掉顶栏「♪ 音乐」胶囊(点了没反应的无效点击);
  5) 每日推荐改横向大卡(日期 + 标题副标题 + 大播放键);
  6) 内容区仍吃满剩余高度(权重 1);
  7) 灵动条加宽(左右留白一致)、下一曲换独立圆形键;
  8) 字号分级放大: 大标题 ts_56 / 区块 ts_44 / 标题 ts_36 / 副标题 ts_28。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky">

    <LinearLayout
        android:id="@+id/musicContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_240">

        <!-- 顶栏: 返回 + 问候 + 线路胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/musicBack"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/musicSearchInput"
                android:text="‹"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_44" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicGreetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_28" />

                <TextView
                    android:id="@+id/musicPaneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:singleLine="true"
                    android:text="晚上好"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_56"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 线路胶囊(可切换音源) -->
            <TextView
                android:id="@+id/musicSourceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_32"
                android:paddingTop="@dimen/vs_20"
                android:paddingRight="@dimen/vs_32"
                android:paddingBottom="@dimen/vs_20"
                android:text="洛雪"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28" />
        </LinearLayout>

        <!-- 搜索: 加宽 + 加高 + 右侧内嵌圆形键 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_120"
            android:layout_marginTop="@dimen/vs_32"
            android:background="@drawable/bg_music_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_36"
            android:paddingRight="@dimen/vs_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_40" />

            <EditText
                android:id="@+id/musicSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_16"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="搜索歌曲 / 歌手 / 歌单"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:nextFocusDown="@+id/musicRows"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/music_sub"
                android:textSize="@dimen/ts_30" />

            <TextView
                android:id="@+id/musicSearchBtn"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/musicRows"
                android:text="⌕"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/vs_12"
            android:singleLine="true"
            android:text="正在加载…"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_24" />

        <!-- 内容区: 吃满剩余高度 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musicRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_music_enter"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_20" />
    </LinearLayout>

    <!-- 底部悬浮区: dock(首页/我的) + 灵动条 -->
    <LinearLayout
        android:id="@+id/musicBottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_32"
        android:paddingRight="@dimen/vs_32"
        android:paddingBottom="@dimen/vs_24">

        <!-- 悬浮 dock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_20"
            android:background="@drawable/bg_music_pill"
            android:orientation="horizontal"
            android:padding="@dimen/vs_10">

            <TextView
                android:id="@+id/musicTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_56"
                android:paddingTop="@dimen/vs_20"
                android:paddingRight="@dimen/vs_56"
                android:paddingBottom="@dimen/vs_20"
                android:text="⌂ 首页"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicTabMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_56"
                android:paddingTop="@dimen/vs_20"
                android:paddingRight="@dimen/vs_56"
                android:paddingBottom="@dimen/vs_20"
                android:text="♫ 我的"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 灵动条(Mini Player) -->
        <LinearLayout
            android:id="@+id/musicPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_player_bar"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_24"
            android:paddingTop="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_20"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/vs_140"
                android:layout_height="@dimen/vs_140">

                <com.github.tvbox.osc.music.CoverRingView
                    android:id="@+id/musicNowRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/musicNowCover"
                    android:layout_width="@dimen/vs_100"
                    android:layout_height="@dimen/vs_100"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_circle"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicNowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_36"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_6"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_28" />
            </LinearLayout>

            <com.github.tvbox.osc.music.BlobPlayButton
                android:id="@+id/musicBlobPlay"
                android:layout_width="@dimen/vs_140"
                android:layout_height="@dimen/vs_140" />

            <!-- v27.16: 下一曲换成独立圆形按钮(原来是一个裸 ⏭ 字符, 太单薄) -->
            <TextView
                android:id="@+id/musicNextBtn"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:layout_marginLeft="@dimen/vs_16"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

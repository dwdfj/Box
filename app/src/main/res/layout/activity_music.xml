<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.12: 音乐首页(Voyage 式) —— 问候语+搜索+每日推荐+最近播放+榜单+底部胶囊导航+灵动条 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_240">

        <!-- 顶栏: 返回 + 问候语 + 音质钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_24"
            android:paddingRight="@dimen/vs_30">

            <TextView
                android:id="@+id/musicBack"
                android:layout_width="@dimen/vs_60"
                android:layout_height="@dimen/vs_60"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/musicSearchInput"
                android:text="‹"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_36" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicGreetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/musicPaneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="晚上好"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_40"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/musicSourceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_24"
                android:paddingTop="@dimen/vs_14"
                android:paddingRight="@dimen/vs_24"
                android:paddingBottom="@dimen/vs_14"
                android:text="flac"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <!-- 搜索胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_30"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_marginRight="@dimen/vs_30"
            android:background="@drawable/bg_music_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_28"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_8">

            <EditText
                android:id="@+id/musicSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索歌曲 / 歌手"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:nextFocusDown="@+id/musicRows"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/music_sub"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/musicSearchBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_34"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_34"
                android:paddingBottom="@dimen/vs_16"
                android:text="搜索"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_30"
            android:singleLine="true"
            android:text="正在加载…"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_22" />

        <!-- 内容区 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musicRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_music_enter"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_20" />
    </LinearLayout>

    <!-- 底部悬浮区: 首页/我的胶囊 + 灵动条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_20">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:background="@drawable/bg_music_pill"
            android:orientation="horizontal"
            android:padding="@dimen/vs_8">

            <TextView
                android:id="@+id/musicTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_44"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_44"
                android:paddingBottom="@dimen/vs_16"
                android:text="⌂ 首页"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicTabMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_8"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_44"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_44"
                android:paddingBottom="@dimen/vs_16"
                android:text="♫ 我的"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <!-- 灵动条(Mini Player): 封面 + 歌名/歌手 + Blob 播放钮 + 下一首 -->
        <LinearLayout
            android:id="@+id/musicPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_player_bar"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_24"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_16"
            android:visibility="gone">

            <ImageView
                android:id="@+id/musicNowCover"
                android:layout_width="@dimen/vs_96"
                android:layout_height="@dimen/vs_96"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicNowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_30"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_22" />
            </LinearLayout>

            <com.github.tvbox.osc.music.BlobPlayButton
                android:id="@+id/musicBlobPlay"
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_120" />

            <TextView
                android:id="@+id/musicNextBtn"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_marginLeft="@dimen/vs_16"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_34" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

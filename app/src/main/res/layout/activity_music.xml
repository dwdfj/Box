<?xml version="1.0" encoding="utf-8"?>
<!--
  小贾影视仓 v27.15: 音乐首页重排 ——
  1) 顶部「正在播放/音源」那行删掉, 只留日期问候 + 线路胶囊 + 音乐胶囊;
  2) 搜索胶囊拉高变大, 与主色调一致;
  3) 内容区吃满剩余高度(权重 1), 不再留大片空白;
  4) 灵动条整体放大(封面 140 / Blob 132 / 歌名 ts_34)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky">

    <LinearLayout
        android:id="@+id/musicContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_240">

        <!-- 顶栏: 返回 + 日期/问候 + 线路胶囊 + 音乐胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_18"
            android:paddingRight="@dimen/vs_30">

            <TextView
                android:id="@+id/musicBack"
                android:layout_width="@dimen/vs_72"
                android:layout_height="@dimen/vs_72"
                android:background="@drawable/bg_music_circle"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/musicSearchInput"
                android:text="‹"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_20"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicPaneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="晚上好"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_50"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicGreetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>

            <!-- 线路胶囊 -->
            <TextView
                android:id="@+id/musicSourceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_pill"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_26"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_26"
                android:paddingBottom="@dimen/vs_16"
                android:text="洛雪"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26" />

            <!-- v27.15: 音乐胶囊(线路胶囊旁, 一进入就是音乐首页) -->
            <TextView
                android:id="@+id/musicEnterBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_14"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_26"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_26"
                android:paddingBottom="@dimen/vs_16"
                android:text="♪ 音乐"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 搜索胶囊(拉高) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_30"
            android:layout_marginTop="@dimen/vs_22"
            android:layout_marginRight="@dimen/vs_30"
            android:background="@drawable/bg_music_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_34" />

            <EditText
                android:id="@+id/musicSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索歌曲 / 歌手 / 歌单"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:nextFocusDown="@+id/musicRows"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/music_sub"
                android:textSize="@dimen/ts_30" />

            <TextView
                android:id="@+id/musicSearchBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:nextFocusDown="@+id/musicRows"
                android:paddingLeft="@dimen/vs_36"
                android:paddingTop="@dimen/vs_18"
                android:paddingRight="@dimen/vs_36"
                android:paddingBottom="@dimen/vs_18"
                android:text="搜索"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_30"
            android:singleLine="true"
            android:text="正在加载…"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_22" />

        <!-- 内容区: 吃满剩余高度 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musicRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_music_enter"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_20" />
    </LinearLayout>

    <!-- 底部悬浮区: 首页/我的胶囊 + 灵动条 -->
    <LinearLayout
        android:id="@+id/musicBottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_20">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_18"
            android:background="@drawable/bg_music_pill"
            android:orientation="horizontal"
            android:padding="@dimen/vs_10">

            <TextView
                android:id="@+id/musicTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_52"
                android:paddingTop="@dimen/vs_18"
                android:paddingRight="@dimen/vs_52"
                android:paddingBottom="@dimen/vs_18"
                android:text="⌂ 首页"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicTabMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_52"
                android:paddingTop="@dimen/vs_18"
                android:paddingRight="@dimen/vs_52"
                android:paddingBottom="@dimen/vs_18"
                android:text="♫ 我的"
                android:textColor="@color/music_sub"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 灵动条(Mini Player): 封面 + 歌名/歌手 + Blob 播放钮 + 下一首 -->
        <LinearLayout
            android:id="@+id/musicPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_player_bar"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_26"
            android:paddingTop="@dimen/vs_18"
            android:paddingRight="@dimen/vs_14"
            android:paddingBottom="@dimen/vs_18"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/vs_140"
                android:layout_height="@dimen/vs_140">

                <com.github.tvbox.osc.music.CoverRingView
                    android:id="@+id/musicNowRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/musicNowCover"
                    android:layout_width="@dimen/vs_92"
                    android:layout_height="@dimen/vs_92"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_circle"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicNowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_34"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_6"
                    android:singleLine="true"
                    android:textColor="@color/music_sub"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>

            <com.github.tvbox.osc.music.BlobPlayButton
                android:id="@+id/musicBlobPlay"
                android:layout_width="@dimen/vs_132"
                android:layout_height="@dimen/vs_132" />

            <TextView
                android:id="@+id/musicNextBtn"
                android:layout_width="@dimen/vs_88"
                android:layout_height="@dimen/vs_88"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

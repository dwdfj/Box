<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v26.8: 选集网格条目(等宽铺满一格)。规则与线路胶囊分开, 因为网格里必须 match_parent 宽,
     否则 wrap_content 的胶囊在 GridLayoutManager 里会排成参差不齐的一列。 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_chip"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_110"
    android:background="@drawable/shape_play_chip_normal"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:maxLines="1"
    android:singleLine="true"
    android:textColor="@android:color/white"
    android:textSize="@dimen/ts_28" />

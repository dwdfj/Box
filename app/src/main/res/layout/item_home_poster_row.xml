<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.22: 影视首页「横排推荐」海报卡(正在热映 / 热门电影 共用)
     —— 竖版海报 2:3 + 左上角备注/评分角标 + 海报底部日期 + 卡片下方片名。
     id 与 UserHomeRowAdapter 对齐(ivThumb/tvNote/tvName/delFrameLayout),
     额外多一个 tvDate(海报内左下角的日期), 适配器里判空写入。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/vs_6">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/mItemFrame"
            android:layout_width="@dimen/vs_230"
            android:layout_height="@dimen/vs_340"
            android:background="@drawable/shape_home_poster"
            android:focusable="false">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_marginTop="@dimen/vs_8"
                android:background="@drawable/shape_home_tag_gold"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="@dimen/vs_120"
                android:paddingLeft="@dimen/vs_8"
                android:paddingRight="@dimen/vs_8"
                android:paddingTop="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_2"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_marginBottom="@dimen/vs_8"
                android:background="@drawable/shape_thumb_note"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_8"
                android:paddingRight="@dimen/vs_8"
                android:paddingTop="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_2"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF_90"
                android:textSize="@dimen/ts_18"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/delFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_user_delete"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_64"
                    android:layout_height="@dimen/vs_64"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_delete" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="@dimen/vs_230"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/color_FFFFFF_90"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>
</FrameLayout>

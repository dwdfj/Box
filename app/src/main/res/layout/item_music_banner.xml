<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.5: 首页推荐大图卡(横滑 Banner, 700x300 圆角 + 底部渐变 + 标题) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/vs_900"
    android:layout_height="@dimen/vs_380"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bannerCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/XjRounded20" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_120"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_music_banner_mask" />

    <TextView
        android:id="@+id/bannerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:paddingLeft="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_16"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_30"
        android:textStyle="bold" />

    <View
        android:id="@+id/bannerRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_music_banner_glow"
        android:visibility="invisible" />
</FrameLayout>

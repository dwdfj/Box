<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.9: 歌单/榜单详情页改上下布局 —— 顶栏 → 歌单信息条(封面+标题+播放全部) → 歌曲列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musicListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sky"
    android:orientation="vertical">

    <!-- 顶栏: 圆形返回 + 标题 + 圆形音源 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_24">

        <TextView
            android:id="@+id/musicListBack"
            android:layout_width="@dimen/vs_72"
            android:layout_height="@dimen/vs_72"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@+id/musicListSource"
            android:text="←"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40" />

        <TextView
            android:id="@+id/musicListTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicListSource"
            android:layout_width="@dimen/vs_72"
            android:layout_height="@dimen/vs_72"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/musicListBack"
            android:nextFocusDown="@+id/musicSongList"
            android:text="源"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_34" />
    </LinearLayout>

    <!-- 歌单信息条: 封面 + 标题/描述 + 播放全部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/musicPaneCover"
            android:layout_width="@dimen/vs_220"
            android:layout_height="@dimen/vs_220"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/XjRounded20" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicPaneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_36"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicPaneDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:id="@+id/musicPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_14"
                android:background="@drawable/bg_music_accent_btn"
                android:focusable="true"
                android:nextFocusDown="@+id/musicSongList"
                android:paddingLeft="@dimen/vs_40"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_40"
                android:paddingBottom="@dimen/vs_16"
                android:text="▶  播放全部"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_28"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/musicListStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_30"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_24" />

    <!-- 歌曲列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/musicSongList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_music_enter"
        android:paddingLeft="@dimen/vs_20"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_20" />

    <!-- 播放进度细条 -->
    <ProgressBar
        android:id="@+id/musicProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_3"
        android:layout_marginLeft="@dimen/vs_24"
        android:layout_marginRight="@dimen/vs_24"
        android:layout_marginBottom="@dimen/vs_10"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_music_accent_bar"
        android:visibility="gone" />

    <!-- 底部播放条 -->
    <LinearLayout
        android:id="@+id/musicPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_24"
        android:layout_marginRight="@dimen/vs_24"
        android:layout_marginBottom="@dimen/vs_20"
        android:background="@drawable/bg_music_player_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_24"
        android:visibility="gone">

        <ImageView
            android:id="@+id/musicNowCover"
            android:layout_width="@dimen/vs_100"
            android:layout_height="@dimen/vs_100"
            android:background="@drawable/bg_music_circle"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicNowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_34"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicNowInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <com.github.tvbox.osc.music.BlobPlayButton
            android:id="@+id/musicBlobPlay"
            android:layout_width="@dimen/vs_120"
            android:layout_height="@dimen/vs_120" />

        <TextView
            android:id="@+id/musicNextBtn"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_12"
            android:focusable="true"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36" />
    </LinearLayout>
</LinearLayout>

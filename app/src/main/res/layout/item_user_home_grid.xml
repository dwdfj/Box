<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.5 首页 3 列网格卡: 海报锁成严格 3:4(与搜索结果卡 item_search 同比例)。
     之前海报高度写死 @dimen/vs_520, 实际宽度是 3 列网格算出来的列宽(不固定),
     于是比例随列宽漂移(≈0.73), 和搜索卡对不上。改用 ConstraintLayout 的
     layout_constraintDimensionRatio="3:4", 高度由列宽按 3:4 算, 两处卡片形状完全一致。
     结构对齐 item_search(角标/片名/删除遮罩 id 不变)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/vs_6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false">

        <!-- 海报: 宽度铺满列宽, 高度 = 宽度 × 4/3 (3:4) -->
        <FrameLayout
            android:id="@+id/mItemFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_home_poster"
            android:focusable="false"
            android:padding="@dimen/vs_2"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <!-- 评分/进度/备注角标(右上角), 空则不显示 -->
            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_marginTop="@dimen/vs_8"
                android:background="@drawable/shape_thumb_note"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="@dimen/vs_110"
                android:paddingLeft="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                android:visibility="gone" />

            <!-- 删除模式遮罩(仅播放历史模式长按进入后显示) -->
            <FrameLayout
                android:id="@+id/delFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/shape_user_delete"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="@dimen/vs_80"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_delete" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/color_FFFFFF_90"
            android:textSize="@dimen/ts_26"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mItemFrame" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

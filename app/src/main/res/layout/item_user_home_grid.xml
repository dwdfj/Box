<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23 竖屏: 首页 3 列网格卡 —— 宽度不再写死 vs_120, 改为 match_parent(V7GridLayoutManager
     会按 spanCount 给出精确列宽), 海报高度 vs_160 → vs_520, 片名 ts_18 → ts_26。
     结构对齐 item_user_home_big(角标/片名/删除遮罩)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/vs_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/mItemFrame"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_520"
            android:background="@drawable/shape_home_poster"
            android:focusable="false"
            android:padding="@dimen/vs_2">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <!-- 评分/进度/备注角标(右上角), 空则不显示 -->
            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_marginTop="@dimen/vs_8"
                android:background="@drawable/shape_thumb_note"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="@dimen/vs_110"
                android:paddingLeft="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                android:visibility="gone" />

            <!-- 删除模式遮罩(仅播放历史模式长按进入后显示) -->
            <FrameLayout
                android:id="@+id/delFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/shape_user_delete"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="@dimen/vs_80"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_delete" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/color_FFFFFF_90"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>
</FrameLayout>

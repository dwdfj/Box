<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.9: 顶部横向标签页条目(胶囊) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_12"
    android:layout_marginRight="@dimen/vs_12"
    android:background="@drawable/bg_music_song"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_32"
    android:paddingTop="@dimen/vs_16"
    android:paddingRight="@dimen/vs_32"
    android:paddingBottom="@dimen/vs_16">

    <View
        android:id="@+id/navDot"
        android:layout_width="@dimen/vs_8"
        android:layout_height="@dimen/vs_30"
        android:background="@drawable/bg_music_accent_bar"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/navName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_16"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_28" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.7: 左侧导航轨条目(强调色选中块 + 文本) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_20"
    android:layout_marginTop="@dimen/vs_8"
    android:layout_marginRight="@dimen/vs_20"
    android:layout_marginBottom="@dimen/vs_8"
    android:background="@drawable/bg_music_song"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_24"
    android:paddingTop="@dimen/vs_22"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_22">

    <View
        android:id="@+id/navDot"
        android:layout_width="@dimen/vs_8"
        android:layout_height="@dimen/vs_32"
        android:background="@drawable/bg_music_accent_bar"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/navName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_20"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_30" />
</LinearLayout>

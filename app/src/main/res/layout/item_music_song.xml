<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.15: 歌曲行放大 —— 编号 + 歌名/歌手 + 右侧时长, 行高更高更好点 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_16"
    android:layout_marginTop="@dimen/vs_6"
    android:layout_marginRight="@dimen/vs_16"
    android:layout_marginBottom="@dimen/vs_6"
    android:background="@drawable/bg_music_song"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_28"
    android:paddingTop="@dimen/vs_24"
    android:paddingRight="@dimen/vs_28"
    android:paddingBottom="@dimen/vs_24">

    <TextView
        android:id="@+id/itemSongIndex"
        android:layout_width="@dimen/vs_72"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#66FFFFFF"
        android:textSize="@dimen/ts_34" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_22"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemSongName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_34" />

        <TextView
            android:id="@+id/itemSongSinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemSongDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_16"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_26" />
</LinearLayout>

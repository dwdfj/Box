<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.9: 歌曲行照喵音乐重做 —— 编号列(大) + 歌名/歌手 + 右侧时长, 去掉小封面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_12"
    android:layout_marginTop="@dimen/vs_5"
    android:layout_marginRight="@dimen/vs_12"
    android:layout_marginBottom="@dimen/vs_5"
    android:background="@drawable/bg_music_song"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_24"
    android:paddingTop="@dimen/vs_18"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_18">

    <TextView
        android:id="@+id/itemSongIndex"
        android:layout_width="@dimen/vs_64"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#66FFFFFF"
        android:textSize="@dimen/ts_30" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_20"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemSongName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30" />

        <TextView
            android:id="@+id/itemSongSinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemSongDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_16"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_24" />
</LinearLayout>

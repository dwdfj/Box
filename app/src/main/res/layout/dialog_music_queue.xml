<?xml version="1.0" encoding="utf-8"?>
<!-- v27.13: 播放队列弹层 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_sheet"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_24"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/queueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="播放队列"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/queueClose"
            android:layout_width="@dimen/vs_50"
            android:layout_height="@dimen/vs_50"
            android:background="@drawable/bg_music_circle"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queueList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_14"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/vs_10" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.21: 影视首页按参考图重排 ——
     顶栏: 左上圆形头像(= 线路切换入口) + 居中「点播」标 + 右上搜索/音乐;
     底部: 悬浮 dock(点播 / 直播 / 设置), 与「我的」音乐页一致的导航形态;
     原「通栏搜索框」隐藏(tvFind 已能直达搜索页), 把高度让给内容区。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_150"
        android:layout_marginTop="@dimen/vs_40"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 左上圆形头像: 点击 = 线路切换(showSiteSwitch) -->
        <FrameLayout
            android:id="@+id/homeAvatar"
            android:layout_width="@dimen/vs_110"
            android:layout_height="@dimen/vs_110"
            android:background="@drawable/shape_home_avatar"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusRight="@id/tvFind"
            android:nextFocusDown="@id/mGridViewCategory">

            <!-- v27.23: 图标可本地更换(长按头像 → 选本地图片), 默认仍用矢量图标 -->
            <ImageView
                android:id="@+id/homeAvatarIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="线路切换"
                android:focusable="false"
                android:padding="@dimen/vs_28"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_home_tv"
                android:tint="@color/color_FFFFFF" />
        </FrameLayout>

        <!-- v27.23: 顶部「点播」二字已按用户要求去掉, 只留头像 + 右侧两个圆键 -->
        <View
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_1"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tvFind"
            android:layout_width="@dimen/vs_110"
            android:layout_height="@dimen/vs_110"
            android:background="@drawable/shape_top_icon_btn"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/homeAvatar"
            android:nextFocusRight="@id/tvMusic"
            android:nextFocusDown="@id/mGridViewCategory"
            android:padding="@dimen/vs_22"
            android:src="@drawable/hm_search" />

        <!-- v27.24: 音乐入口从圆键改成「灵动胶囊」—— 图标 + 文字, 面积更大更好点 -->
        <LinearLayout
            android:id="@+id/tvMusic"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_130"
            android:layout_marginStart="@dimen/vs_16"
            android:layout_marginLeft="@dimen/vs_16"
            android:background="@drawable/shape_top_music_capsule"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/tvFind"
            android:nextFocusDown="@id/mGridViewCategory"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_26"
            android:paddingRight="@dimen/vs_32">

            <ImageView
                android:layout_width="@dimen/vs_52"
                android:layout_height="@dimen/vs_52"
                android:contentDescription="音乐"
                android:focusable="false"
                android:src="@drawable/hm_music" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_14"
                android:focusable="false"
                android:text="音乐"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 逻辑残留: 代码里仍会往 tvName 写线路名并做闪烁动画, 这里不占位 -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_0"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_340"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <LinearLayout
            android:id="@+id/homeSearchBar"
            android:layout_width="match_parent"
            android:layout_height="0mm"
            android:visibility="gone"
            android:orientation="horizontal" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_marginBottom="@dimen/vs_10"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusDown="@id/mViewPager"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40"
            app:tv_selectedItemIsCentered="true" />

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 底部 dock: 点播 / 直播 / 设置 (v27.25: 苹果式悬浮药丸 —— 更厚 vs_200、更短 左右 vs_120) -->
    <LinearLayout
        android:id="@+id/homeDock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_200"
        android:layout_marginLeft="@dimen/vs_120"
        android:layout_marginRight="@dimen/vs_120"
        android:layout_marginBottom="@dimen/vs_90"
        android:background="@drawable/shape_home_dock"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_18"
        android:paddingTop="@dimen/vs_18"
        android:paddingRight="@dimen/vs_18"
        android:paddingBottom="@dimen/vs_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/dockVideo"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_160"
            android:layout_weight="1"
            android:background="@drawable/bg_music_dock_item"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/vs_84"
                android:layout_height="@dimen/vs_84"
                android:contentDescription="点播"
                android:src="@drawable/ic_home_tv"
                android:tint="@color/music_dock_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockLive"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_160"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/bg_music_dock_item"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tvLive"
                android:layout_width="@dimen/vs_84"
                android:layout_height="@dimen/vs_84"
                android:background="@null"
                android:contentDescription="直播"
                android:src="@drawable/hm_live"
                android:tint="@color/music_dock_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockSetting"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_160"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/bg_music_dock_item"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tvMenu"
                android:layout_width="@dimen/vs_84"
                android:layout_height="@dimen/vs_84"
                android:background="@null"
                android:contentDescription="设置"
                android:src="@drawable/hm_settings"
                android:tint="@color/music_dock_tint" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

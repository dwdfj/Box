<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23 —— 竖屏版首页(v23 起 App 锁竖屏, 见 AndroidManifest screenOrientation=sensorPortrait)。
     自上而下: 顶栏胶囊(标题=信号源面板 / 搜索 / 设置) → 通栏搜索框 → 分类胶囊 → ViewPager(推荐页 + 各分类页)。
     主题是全屏(windowFullscreen=true, 无通知栏), 所以顶栏只留一点呼吸边距, 不需要避让状态栏。

     ⚠️ AutoSize 基准(勿改): App.java 里已确保 screenWidth = 屏幕**短边**。竖屏下系数 = 短边px / 1280
     (Mate70: 1224/1280 ≈ 0.956), 所以这里的 `vs_N` 就是"1280 宽设计稿单位", 占屏宽比例恒定:
     vs_40 = 3.1% 屏宽, vs_140 = 10.9% 屏宽(≈手机 56dp 标准顶栏), vs_64 ≈ 24dp 图标。
     ⚠️ 高度预算: 首页推荐区是 weight=1 弹性布局, 固定部分(顶栏+搜索框+分类)合计 ≈ 436 单位,
     屏高约 2824 单位(2700px/0.956) → 剩余 ≈ 2388 给内容区。新增顶部控件前务必先算这笔账。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_140"
        android:layout_marginTop="@dimen/vs_30"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="@dimen/vs_5"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/vs_34"
            android:layout_marginEnd="@dimen/vs_16"
            android:layout_marginRight="@dimen/vs_16"
            android:layout_marginBottom="@dimen/vs_34"
            android:background="?attr/color_theme" />

        <!-- 标题胶囊: 跟着文字自适应宽度, 右侧 spacer 把图标组顶到最右 -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/shape_home_title"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="left|center_vertical"
            android:nextFocusDown="@id/homeSearchBar"
            android:nextFocusRight="@id/tvFind"
            android:paddingLeft="@dimen/vs_30"
            android:paddingRight="@dimen/vs_30"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <!-- 撑开用: 把右侧「搜索 / 直播 / 设置」图标组顶到最右端 -->
        <View
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_1"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tvFind"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_top_icon_btn"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusRight="@id/tvLive"
            android:padding="@dimen/vs_18"
            android:src="@drawable/hm_search" />

        <!-- 直播: 小贾影视仓 v23 —— 从首页底部 dock 上移至顶栏, 紧挨设置(用户要求) -->
        <ImageView
            android:id="@+id/tvLive"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_top_icon_btn"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/tvFind"
            android:nextFocusRight="@id/tvMenu"
            android:padding="@dimen/vs_18"
            android:src="@drawable/hm_live" />

        <ImageView
            android:id="@+id/tvMenu"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_top_icon_btn"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/tvLive"
            android:nextFocusDown="@id/homeSearchBar"
            android:padding="@dimen/vs_18"
            android:src="@drawable/hm_settings" />

    </LinearLayout>

    <!-- 搜索框放在 contentLayout **内部**当第一行: 首页推荐区是 weight=1 弹性布局,
         放在外面当兄弟节点会整体压缩内容区高度(v20 踩过这个坑, 见 MEMORY 高度预算铁律)。 -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <!-- 通栏搜索框(独立一条, 宽度吃满, 点击直达搜索页) -->
        <LinearLayout
            android:id="@+id/homeSearchBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_128"
            android:layout_marginLeft="@dimen/vs_40"
            android:layout_marginStart="@dimen/vs_40"
            android:layout_marginTop="@dimen/vs_16"
            android:layout_marginRight="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_40"
            android:layout_marginBottom="@dimen/vs_16"
            android:background="@drawable/shape_home_search_box"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/mGridViewCategory"
            android:nextFocusUp="@id/tvName"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_36"
            android:paddingRight="@dimen/vs_36">

            <ImageView
                android:layout_width="@dimen/vs_36"
                android:layout_height="@dimen/vs_36"
                android:alpha="0.75"
                android:contentDescription="@string/hm_search"
                android:focusable="false"
                app:srcCompat="@drawable/hm_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_18"
                android:layout_marginStart="@dimen/vs_18"
                android:focusable="false"
                android:text="@string/hm_search_box_hint"
                android:textColor="@color/color_FFFFFF_60"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusDown="@id/mViewPager"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40"
            app:tv_selectedItemIsCentered="true" />

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

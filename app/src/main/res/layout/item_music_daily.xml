<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.15: 每日推荐卡放大 —— 日期块 + 标题/描述 + 大播放圆钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_24"
    android:layout_marginTop="@dimen/vs_12"
    android:layout_marginRight="@dimen/vs_24"
    android:layout_marginBottom="@dimen/vs_12"
    android:background="@drawable/bg_music_player_bar"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_34"
    android:paddingTop="@dimen/vs_32"
    android:paddingRight="@dimen/vs_28"
    android:paddingBottom="@dimen/vs_32">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dailyWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周二"
            android:textColor="@color/music_accent"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:text="3"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_50"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dailyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_36"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:singleLine="true"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>

    <TextView
        android:id="@+id/dailyPlay"
        android:layout_width="@dimen/vs_120"
        android:layout_height="@dimen/vs_120"
        android:background="@drawable/bg_music_accent_btn"
        android:focusable="true"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_40" />
</LinearLayout>

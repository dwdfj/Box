<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.18: 每日推荐大卡 —— 高度定死 vs_250, 左侧日期块 + 中间标题/说明/三张封面缩略 + 右侧大播放键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_250"
    android:layout_marginTop="@dimen/vs_8"
    android:layout_marginBottom="@dimen/vs_20"
    android:background="@drawable/bg_music_player_bar"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_32"
    android:paddingTop="@dimen/vs_28"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_28">

    <!-- v27.30: 去掉左侧「周三 / 4」日期块 —— 用户反馈看不懂这两个数字, 且挤占了标题宽度 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dailyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_44"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:singleLine="true"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_28" />

        <!-- 三张封面缩略, 叠一点边做出堆叠感 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dailyThumb1"
                android:layout_width="@dimen/vs_72"
                android:layout_height="@dimen/vs_72"
                android:background="@drawable/bg_music_thumb"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/dailyThumb2"
                android:layout_width="@dimen/vs_72"
                android:layout_height="@dimen/vs_72"
                android:layout_marginLeft="@dimen/vs_4_"
                android:background="@drawable/bg_music_thumb"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/dailyThumb3"
                android:layout_width="@dimen/vs_72"
                android:layout_height="@dimen/vs_72"
                android:layout_marginLeft="@dimen/vs_4_"
                android:background="@drawable/bg_music_thumb"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dailyPlay"
        android:layout_width="@dimen/vs_160"
        android:layout_height="@dimen/vs_160"
        android:layout_marginLeft="@dimen/vs_16"
        android:background="@drawable/bg_music_accent_btn"
        android:focusable="true"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_44" />
</LinearLayout>

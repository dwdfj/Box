<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.16: 每日推荐横向大卡(日期 + 标题/描述 + 曲数 + 大播放钮) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/vs_8"
    android:layout_marginBottom="@dimen/vs_20"
    android:background="@drawable/bg_music_player_bar"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_40"
    android:paddingRight="@dimen/vs_32"
    android:paddingBottom="@dimen/vs_40">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/vs_110"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dailyWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周二"
            android:textColor="@color/music_accent"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:text="3"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_56"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_36"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dailyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/music_sub"
            android:textSize="@dimen/ts_28" />
    </LinearLayout>

    <TextView
        android:id="@+id/dailyPlay"
        android:layout_width="@dimen/vs_140"
        android:layout_height="@dimen/vs_140"
        android:background="@drawable/bg_music_accent_btn"
        android:focusable="true"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_44" />
</LinearLayout>

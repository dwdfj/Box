<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.18: 信号源面板 —— 左列线路(配置级) / 右列站点(SourceBean)。
     v27.1 用 ConstraintLayout 的 0dp 双向约束链来"竖向拉长", 在 Dialog 的 wrap 窗口里
     高度会先按 0 算, 于是两列列表塌成一条缝 —— 用户看到的就是"点胶囊没有线路可选了"。
     现在改回最朴素的垂直 LinearLayout: 标题(wrap) + 主体(0dp/weight=1) + 底部按钮(wrap),
     高度由 Dialog 窗口的 MATCH_PARENT 决定, 不依赖任何约束链, 一定能撑开。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/cl_root"
        android:layout_width="@dimen/vs_1240"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="@dimen/vs_10"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_32"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_32"
        android:paddingBottom="@dimen/vs_32">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:shadowColor="@color/color_FF000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:singleLine="true"
            android:text="信号源 · 线路 / 站点"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <!-- 中部: 左线路列 + 分隔 + 右站点列。
             height=0dp + weight=1 —— 父级是垂直 LinearLayout 且高度确定(match_parent),
             这种写法在 LinearLayout 里是稳定的"吃掉剩余空间", 不会像约束链那样塌缩。 -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/vs_420"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/vs_10"
                    android:text="线路(配置)"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_26"
                    android:textStyle="bold" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/panelLineList"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_0"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/vs_2"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_20"
                android:layout_marginRight="@dimen/vs_20"
                android:background="@color/color_FFFFFF_20" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/panelSiteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:paddingBottom="@dimen/vs_10"
                    android:singleLine="true"
                    android:text="站点"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_26"
                    android:textStyle="bold" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/panelSiteList"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_0"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部: 样式开关 + 线路配置入口 -->
        <LinearLayout
            android:id="@+id/panelFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panelStyleBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_80"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_vod"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:singleLine="true"
                android:text="首页样式"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26"
                tools:text="首页样式" />

            <TextView
                android:id="@+id/panelConfigBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_80"
                android:layout_marginLeft="@dimen/vs_14"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_vod"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:singleLine="true"
                android:text="线路配置"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26" />

            <!-- 小贾影视仓 v21: 本地 Python 单源加载入口 -->
            <TextView
                android:id="@+id/panelPyBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_80"
                android:layout_marginLeft="@dimen/vs_14"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_vod"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:singleLine="true"
                android:text="加载 .py"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/panelCloseBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_80"
                android:layout_marginLeft="@dimen/vs_14"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_vod"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:singleLine="true"
                android:text="返回"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

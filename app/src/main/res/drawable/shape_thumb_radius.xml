<?xml version="1.0" encoding="utf-8"?>
<!-- APP软件管理图标和略缩图单独圆角背景 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14px" />
            <!-- v27.28: 焦点边由白改主题紫, 与选集/线路胶囊的"紫色=当前项"保持一致 -->
            <stroke android:width="3mm" android:color="#8B6BFF" />
            <solid android:color="#4D8B6BFF" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="14px" />
            <solid android:color="#36ffffff"/>
            <!-- v24.0 冰晶蓝玻璃: 冰蓝细描边 -->
            <stroke android:width="1mm" android:color="#4D8B6BFF" />
        </shape>
    </item>
</selector>
<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.18: 胶囊形「选择项」背景(搜索来源渠道 / 热搜词 / 历史词)。
     选中态用主题紫实底 + 白描边, 与 shape_chip_select 语义一致, 只是圆角做成全圆。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/vs_90" />
            <stroke android:width="@dimen/vs_3" android:color="@color/color_FFFFFF" />
            <solid android:color="?attr/color_theme_60" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_90" />
            <stroke android:width="@dimen/vs_3" android:color="@color/color_FFFFFF" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_90" />
            <stroke android:width="@dimen/vs_1" android:color="@color/color_FFFFFF_20" />
            <solid android:color="@color/color_aurora_line" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v22: 首页左侧「精选大图 Banner」底。
     与底部「更多」按钮原先共用 shape_dock_btn(radius 28mm), 但那是个"实心黑底"资源,
     放大到整块 Banner 上会显得发闷。这里给 Banner 单独一条: 大圆角 + 极细白描边,
     底色近乎透明(海报图铺满后只在 padding 1 单位的一圈露出), 视觉更"卡片"、更透气。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/vs_26" />
    <solid android:color="#14000000" />
    <stroke android:width="1.5mm" android:color="#33FFFFFF" />
</shape>

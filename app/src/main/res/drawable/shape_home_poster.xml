<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v22: 首页网格海报卡片的圆角底。
     旧版沿用 shape_thumb_radius 的 `14px` 字面半径 —— 在 120x160 的卡片上几乎等于直角,
     看起来"糊成一片"。本资源改用项目统一的设计稿单位(vs_16), 圆角随屏宽等比缩放。
     v24.0 冰晶蓝玻璃: 静默态加一圈冰蓝细描边(海报铺满时可见 1 单位冰圈);
     聚焦 = 白描边 + 主题色(冰晶蓝)底, 反馈更强。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_16" />
            <stroke android:width="2mm" android:color="@color/color_FFFFFF" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1mm" android:color="#663EC8F5" />
        </shape>
    </item>
</selector>

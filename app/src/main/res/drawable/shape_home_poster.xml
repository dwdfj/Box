<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.0 Aurora: 首页网格海报卡底。
     圆角 vs_16 → vs_20（大圆角是现代流媒体卡片的共同特征，Netflix/Disney+ 都在 16~24 区间）。
     静默态去掉彩色描边，只留 12% 白底 + 20% 白边：海报加载前不突兀，加载后描边几乎不可见，
     不会像旧版紫圈那样把海报框成一个"票根"。
     聚焦态 = 主题紫粗边 + 紫 30% 底(v27.28: 由白边改成紫边 —— 用户要求"移动到哪个哪个是紫色",
     白边在浅色海报上看不出来)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_20" />
            <stroke android:width="3mm" android:color="#8B6BFF" />
            <solid android:color="#4D8B6BFF" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_20" />
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1mm" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>

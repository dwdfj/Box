<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.3: 播放页卡片内的可点元素底(图标钮、倒序/全部、全屏/投屏/收藏)。
     v24.0 冰晶蓝玻璃: 半透明白底 + 冰蓝细描边。
     v27.28: 改成 selector —— 焦点态 = 主题紫实底, 用户要求"移动到哪个哪个是紫色"。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#8B6BFF" />
            <stroke android:width="@dimen/vs_2" android:color="@color/color_FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1mm" android:color="#4D8B6BFF" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.0 Aurora: 首页标题胶囊。
     与启动图标同源 —— 斜向极光紫渐变(浅紫 → 主紫 → 深紫) + 22% 白内描边模拟玻璃高光。
     v24.2 鎏金那版是纯横向金渐变，横向渐变在胶囊上会显得"扁"，斜向才有体积感。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="@dimen/vs_70" />
    <gradient
        android:angle="315"
        android:startColor="@color/color_aurora_accent_hi"
        android:centerColor="@color/color_aurora_accent"
        android:endColor="@color/color_aurora_accent_dp"
        android:type="linear" />
    <stroke android:width="1mm" android:color="#38FFFFFF" />
</shape>

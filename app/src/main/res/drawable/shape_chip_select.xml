<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.18: 通用「选择项」背景 —— 未选=墨灰、选中=主题紫实底+白描边、聚焦=主题紫半透+白描边。
     以前 shape_user_focus 只有 state_focused, 点选之后松手就恢复成灰底,
     用户根本看不出"我选的是哪个"(搜索结果来源、站点面板都是这个问题)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <stroke android:width="@dimen/vs_3" android:color="@color/color_FFFFFF" />
            <solid android:color="?attr/color_theme_60" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <stroke android:width="@dimen/vs_3" android:color="@color/color_FFFFFF" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <stroke android:width="@dimen/vs_1" android:color="@color/color_FFFFFF_20" />
            <solid android:color="@color/color_aurora_line" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.28: 播放页「线路」胶囊底。
     三态: 当前线路 = 紫实底(一直可见) / 焦点所在 = 紫实底+白边 / 其余 = 冰蓝玻璃底。
     用户要求: 移动焦点到哪一项, 哪一项就变紫。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#8B6BFF" />
            <stroke android:width="@dimen/vs_2" android:color="@color/color_FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#8B6BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vs_16" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1mm" android:color="#4D8B6BFF" />
        </shape>
    </item>
</selector>

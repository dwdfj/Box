<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v15.5: 「立即播放」红色胶囊按钮(聚焦时白描边微亮) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/color_theme_70" />
            <stroke android:width="2mm" android:color="@color/color_FFFFFF_90" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/color_theme_70" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/color_theme" />
            <stroke android:width="2mm" android:color="@color/color_FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/color_theme" />
        </shape>
    </item>
</selector>

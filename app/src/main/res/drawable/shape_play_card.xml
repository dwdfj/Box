<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v27.0 Aurora: 竖屏播放页信息面板底。
     墨黑玻璃 #CC101219 + 12% 白细边，圆角 vs_28。
     旧版是深棕/深海军蓝 + 彩色描边，一整块面板会显脏；现在描边降到几乎不可见，
     靠"比页面底色亮一级"来分层，才像 iOS/Netflix 那种干净的深色面板。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/vs_28" />
    <solid android:color="#CC101219" />
    <stroke android:width="1mm" android:color="#1FFFFFFF" />
</shape>

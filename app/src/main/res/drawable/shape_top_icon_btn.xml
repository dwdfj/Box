<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v15.11: 首页顶栏图标按钮(搜索/抽屉/设置)专用底 ——
     默认态半透明深色圆底, 保证白色图标在浅色透壁纸上清晰可见;
     聚焦/按压态沿用主题色(color_theme_40) + 白描边反馈。
     不能直接改 button_dialog_vod(播放器/历史/收藏等几十处复用)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="?attr/color_theme_40" />
            <!--添加选中外边框-->
            <stroke android:width="2mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="#66000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>

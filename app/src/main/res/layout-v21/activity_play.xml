<?xml version="1.0" encoding="utf-8"?>
<!-- 小贾影视仓 v23.3: 竖屏半屏播放(对齐 AVBox 竖屏播放器)。
     上半区 = 视频(高度按屏宽×9/16 动态换算, 16:9 正好铺满不留黑边);
     下半区 = 卡片式信息流(标题行+操作图标 / 来源·年份胶囊 / 简介卡 / 线路胶囊 / 选集胶囊),
     每张卡片深色圆角 + 左右留边距, 卡片之间留间距。整区可上下滚动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_32364E_40"
    android:orientation="vertical">

    <!-- 上半: 视频画面(高度由 Java 按屏宽换算, 兜底 vs_700) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_700"
        android:background="@android:color/black">

        <com.github.tvbox.osc.player.MyVideoView
            android:id="@+id/mVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <master.flame.danmaku.ui.widget.DanmakuView
            android:id="@+id/danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/play_loading"
            android:layout_width="@dimen/vs_70"
            android:layout_height="@dimen/vs_70"
            android:layout_gravity="center"
            android:indeterminateBehavior="repeat"
            android:indeterminateTintMode="src_atop"
            android:indeterminateTint="?attr/color_theme_70"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateOnly="true" />

        <ImageView
            android:id="@+id/play_load_error"
            android:layout_width="@dimen/vs_70"
            android:layout_height="@dimen/vs_70"
            android:layout_gravity="center"
            android:alpha="0.75"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/icon_error"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/play_load_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_70"
            android:text="Now Loading"
            android:textColor="@color/color_FFFFFF_80"
            android:textSize="@dimen/ts_24" />
    </FrameLayout>

    <!-- 下半: 卡片式播放信息区 -->
    <ScrollView
        android:id="@+id/infoScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_24"
            android:paddingTop="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            android:paddingBottom="@dimen/vs_40">

            <!-- ① 卡片: 片名 + 操作图标(音乐/投屏/收藏) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_play_card"
                android:orientation="vertical"
                android:padding="@dimen/vs_28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/play_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="片名"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_38"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_play_music"
                        android:layout_width="@dimen/vs_72"
                        android:layout_height="@dimen/vs_72"
                        android:layout_marginStart="@dimen/vs_16"
                        android:layout_marginLeft="@dimen/vs_16"
                        android:background="@drawable/shape_play_card_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/vs_16"
                        android:src="@drawable/hm_up_down" />

                    <ImageView
                        android:id="@+id/btn_play_cast"
                        android:layout_width="@dimen/vs_72"
                        android:layout_height="@dimen/vs_72"
                        android:layout_marginStart="@dimen/vs_16"
                        android:layout_marginLeft="@dimen/vs_16"
                        android:background="@drawable/shape_play_card_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/vs_16"
                        android:src="@drawable/hm_live" />

                    <ImageView
                        android:id="@+id/btn_play_collect"
                        android:layout_width="@dimen/vs_72"
                        android:layout_height="@dimen/vs_72"
                        android:layout_marginStart="@dimen/vs_16"
                        android:layout_marginLeft="@dimen/vs_16"
                        android:background="@drawable/shape_play_card_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/vs_16"
                        android:src="@drawable/hm_fav" />
                </LinearLayout>

                <!-- 来源 / 类型 / 年份 / 地区 胶囊行 -->
                <LinearLayout
                    android:id="@+id/play_meta_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_20"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- ② 卡片: 简介(默认 2 行, 可展开) -->
            <LinearLayout
                android:id="@+id/play_des_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:background="@drawable/shape_play_card"
                android:orientation="vertical"
                android:padding="@dimen/vs_28">

                <TextView
                    android:id="@+id/play_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="@dimen/vs_6"
                    android:maxLines="2"
                    android:textColor="@color/color_FFFFFF_80"
                    android:textSize="@dimen/ts_28"
                    tools:text="影片以当代为背景，讲述了一个有抱负的男青年在个人事业发展中历经沧桑…" />

                <TextView
                    android:id="@+id/play_des_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/vs_8"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="展开"
                    android:textColor="@color/color_FFFFFF_60"
                    android:textSize="@dimen/ts_26"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ③ 卡片: 线路 -->
            <LinearLayout
                android:id="@+id/play_line_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:background="@drawable/shape_play_card"
                android:orientation="vertical"
                android:padding="@dimen/vs_28">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="线路"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_30"
                    android:textStyle="bold" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/play_line_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_16"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_16"
                    app:tv_selectedItemIsCentered="false" />
            </LinearLayout>

            <!-- ④ 卡片: 选集(带倒序/全部) -->
            <LinearLayout
                android:id="@+id/play_episode_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:background="@drawable/shape_play_card"
                android:orientation="vertical"
                android:padding="@dimen/vs_28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="选集"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_30"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_episode_sort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_play_card_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingLeft="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_20"
                        android:paddingTop="@dimen/vs_10"
                        android:paddingBottom="@dimen/vs_10"
                        android:text="↓ 倒序"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_24" />

                    <TextView
                        android:id="@+id/btn_episode_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vs_16"
                        android:layout_marginLeft="@dimen/vs_16"
                        android:background="@drawable/shape_play_card_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingLeft="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_20"
                        android:paddingTop="@dimen/vs_10"
                        android:paddingBottom="@dimen/vs_10"
                        android:text="⊞ 全部"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_24" />
                </LinearLayout>

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/play_episode_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_16"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_16"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_16" />
            </LinearLayout>

            <TextView
                android:id="@+id/play_info_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_24"
                android:gravity="center"
                android:text="轻触画面显示控制 · 双击暂停"
                android:textColor="@color/color_FFFFFF_40"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>